#!/usr/bin/env bash
# claude-dispatch — bootstrap a Claude Code worktree + tmux session that runs /dispatch on a GitHub issue.
#
#   claude-dispatch <repo-name-or-path> <issue-number> [approach-suffix] [-p <paired-repo>]
#
# Examples:
#   claude-dispatch gelos-lc 26              # worktree issue-26
#   claude-dispatch gelos-lc 26 approachB    # worktree issue-26-approachB  (manual fan-out)
#   claude-dispatch /mnt/workspace/Denys/solar 14
#   claude-dispatch gelos 63 -p gelos-lc     # also creates issue-63 worktree in gelos-lc
#
# A bare repo name is resolved against, in order: the directory the command is
# run from, the parent of the enclosing git repo (so sibling repos are found
# when run from inside one), then DISPATCH_REPO_ROOTS (colon-separated).
# An optional approach-suffix lets you open several worktrees for the SAME issue
# without the worktree/branch names colliding — one independent attempt each.
# -p <paired-repo> creates a matching named worktree in a second repo so you can
# test cross-repo changes together (e.g. point PYTHONPATH at the gelos worktree
# when running gelos-lc in Docker).
# This script does the one thing a /skill can't: create the worktree + session.
# Once inside, the /dispatch skill fetches the issue body itself via gh.

set -euo pipefail

# Options may appear anywhere among the positional arguments.
paired_repo=""
positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--paired)
      if [[ -z "${2:-}" ]]; then echo "$1 requires an argument" >&2; exit 1; fi
      paired_repo="$2"; shift 2;;
    -*) echo "unknown option: $1" >&2; exit 1;;
    *) positional+=("$1"); shift;;
  esac
done

if [[ ${#positional[@]} -gt 3 ]]; then
  echo "too many arguments: ${positional[*]}" >&2
  exit 1
fi
repo="${positional[0]:-}"; issue="${positional[1]:-}"; suffix="${positional[2]:-}"
if [[ -z "$repo" || -z "$issue" ]]; then
  echo "usage: claude-dispatch <repo-name-or-path> <issue-number> [approach-suffix] [-p <paired-repo>]" >&2
  exit 1
fi
if ! [[ "$issue" =~ ^[0-9]+$ ]]; then
  echo "issue must be a number, got: '$issue'" >&2
  exit 1
fi
if [[ -n "$suffix" && ! "$suffix" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "approach-suffix may only contain letters, digits, '.', '_', '-'; got: '$suffix'" >&2
  exit 1
fi

# Resolve a repo argument to an absolute git working directory: an explicit
# path, or a bare name searched under (in order) the invocation directory, the
# parent of the enclosing git repo (finds sibling repos when run from inside
# one), then DISPATCH_REPO_ROOTS (colon-separated, default ~/workspace).
resolve_repo() {
  local name="$1" r top
  if [[ -d "$name/.git" ]]; then
    (cd "$name" && pwd); return 0
  fi
  local -a roots=("$PWD") env_roots
  if top="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    roots+=("$(dirname "$top")")
  fi
  IFS=':' read -r -a env_roots <<< "${DISPATCH_REPO_ROOTS:-$HOME/workspace}"
  roots+=("${env_roots[@]}")
  for r in "${roots[@]}"; do
    if [[ -d "$r/$name/.git" ]]; then (cd "$r/$name" && pwd); return 0; fi
  done
  return 1
}

if ! path="$(resolve_repo "$repo")"; then
  echo "no git repo named '$repo' found (searched ., the enclosing repo's parent, and DISPATCH_REPO_ROOTS)" >&2
  exit 1
fi

# Resolve the paired repo now too — BEFORE cd'ing into the main repo, so a bare
# name still resolves against the directory the command was run from.
paired_path=""
if [[ -n "$paired_repo" ]]; then
  if ! paired_path="$(resolve_repo "$paired_repo")"; then
    echo "no git repo named '$paired_repo' found (searched ., the enclosing repo's parent, and DISPATCH_REPO_ROOTS)" >&2
    exit 1
  fi
fi

cd "$path"

# Persist the repo path so ls/clean can find it after a restart without needing
# DISPATCH_REPO_ROOTS or a CWD inside a git repo.
_registry="${XDG_DATA_HOME:-$HOME/.local/share}/claude-dispatch/repos"
mkdir -p "$(dirname "$_registry")"
grep -qxF "$path" "$_registry" 2>/dev/null || echo "$path" >> "$_registry"

# Confirm the issue exists and grab its title for a readable launch line.
if ! title="$(gh issue view "$issue" --json title -q .title 2>/dev/null)"; then
  echo "could not fetch issue #$issue in $(basename "$path") — is gh authed for its remote?" >&2
  exit 1
fi

wt="issue-$issue"
[[ -n "$suffix" ]] && wt="issue-$issue-$suffix"
session="disp-$wt"      # readable tmux name, e.g. disp-issue-26 / disp-issue-26-approachB

# Don't clobber a run already in flight for the same worktree.
if tmux has-session -t "$session" 2>/dev/null; then
  echo "tmux session '$session' already exists — attach with:  tmux attach -t $session" >&2
  exit 1
fi

# If a paired repo was requested, create its matching worktree now — before
# starting the session, so problems fail fast. (Resolution happened up top.)
if [[ -n "$paired_path" ]]; then
  mkdir -p "$paired_path/.claude/worktrees"
  if git -C "$paired_path" worktree list | grep -q "/$wt "; then
    echo "paired worktree $wt already exists in $(basename "$paired_path")" >&2
  else
    git -C "$paired_path" worktree add -b "$wt" "$paired_path/.claude/worktrees/$wt" \
      || git -C "$paired_path" worktree add "$paired_path/.claude/worktrees/$wt" "$wt"
  fi
fi

echo "▶ $(basename "$path") #$issue → worktree $wt  (tmux: $session): $title"
if [[ -n "$paired_path" ]]; then
  echo "  paired: $(basename "$paired_path")  →  $paired_path/.claude/worktrees/$wt"
  echo "  docker: PYTHONPATH=$paired_path/.claude/worktrees/$wt:\$PYTHONPATH"
fi

# Launch: isolated worktree, cheap supervisor model, permissions fully bypassed so
# the run (including the fable/opus subagents /dispatch spawns) never blocks on a prompt.
# The isolated worktree is the sandbox that makes bypassPermissions acceptable here.
#
# We create the tmux session OURSELVES and run `claude --worktree` (NOT `claude --tmux`)
# inside it, so the session gets a readable name — `disp-<worktree>` shows up in the
# `Ctrl-b s` picker and `tmux attach -t`. `--worktree` still creates/uses the worktree;
# `--tmux` would only have spawned an auto-named session (and its iTerm2 control-mode
# integration is moot on Linux, where it falls back to classic tmux anyway). `exec` means
# the session closes when Claude exits.
cmd=$(printf 'exec claude --worktree %q --model sonnet --permission-mode bypassPermissions %q' \
  "$wt" "/dispatch #$issue")
tmux new-session -d -s "$session" -c "$path" "$cmd"

# Attach — or switch, if we're invoked from inside an existing tmux client.
if [[ -n "${TMUX:-}" ]]; then
  exec tmux switch-client -t "$session"
else
  exec tmux attach -t "$session"
fi
