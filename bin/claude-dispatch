#!/usr/bin/env bash
# claude-dispatch — run Claude Code's /dispatch on a GitHub issue as a tmux WINDOW inside the
# repo's project session (the one sesh creates per repo), in a git worktree under <repo>/.git/wt/.
#
#   claude-dispatch new    <repo> <issue> [suffix] [-i] [--light|--full]   start a run in window issue-N[-suffix]
#   claude-dispatch ls     [repo]                                    worktrees ↔ windows, flag orphans
#   claude-dispatch resume [repo] [issue [suffix]]                   relaunch saved Claude sessions (after a reboot)
#   claude-dispatch clean  <repo> <issue> [suffix] [-y] [--force]    kill the window, remove worktree + branch
#
#   claude-dispatch <repo> <issue> [suffix] [-i]   is shorthand for `new`.
#   --light / --full force the run's tier (cheap single-stage vs. plan → execute); default: the supervisor triages.
#
# Model:
#   * one tmux session per repo — named the way sesh names it (directory basename), created by
#     sesh if it isn't running yet;
#   * one window per issue/approach, named issue-N[-suffix], rooted in the worktree;
#   * the worktree lives at <repo>/.git/wt/issue-N[-suffix] on branch issue-N[-suffix], created with
#     plain `git worktree add` (git owns it; nothing to gitignore, and rg/fd never search it);
#   * every window runs `claude --remote-control <repo>/issue-N[-suffix]`, so each run is
#     individually reachable from claude.ai/code and the Claude mobile app.
#
# A bare repo name resolves against, in order: the current directory, the parent of the enclosing
# git repo, DISPATCH_REPO_ROOTS (colon-separated, default ~/workspace), then the registry of repos
# previous runs recorded (~/.local/share/claude-dispatch/repos).
#
# Env: DISPATCH_REPO_ROOTS, DISPATCH_MODEL (supervisor model, default sonnet).
# Requires bash 3.2+, git, tmux, gh; uses sesh when present (falls back to plain tmux).

set -euo pipefail

roots_default="$HOME/workspace"
registry="${XDG_DATA_HOME:-$HOME/.local/share}/claude-dispatch/repos"
projects="$HOME/.claude/projects"
model="${DISPATCH_MODEL:-sonnet}"

die() { echo "claude-dispatch: $*" >&2; exit 1; }

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

# ---------------------------------------------------------------- repo resolution
resolve_repo() {   # <name-or-path> -> absolute path of a git working dir (main checkout)
  local name="$1" r top
  if [[ -d "$name/.git" ]]; then (cd "$name" && pwd -P); return 0; fi
  local roots=("$PWD")
  if top="$(git rev-parse --show-toplevel 2>/dev/null)"; then roots+=("$(dirname "$top")"); fi
  local env_roots
  IFS=':' read -r -a env_roots <<< "${DISPATCH_REPO_ROOTS:-$roots_default}"
  roots+=("${env_roots[@]}")
  for r in "${roots[@]}"; do
    [[ -d "$r/$name/.git" ]] && { (cd "$r/$name" && pwd -P); return 0; }
  done
  if [[ -f "$registry" ]]; then
    while IFS= read -r r; do
      [[ "$(basename "$r")" == "$name" && -d "$r/.git" ]] && { echo "$r"; return 0; }
    done < "$registry"
  fi
  return 1
}

resolve_repo_or_die() {
  resolve_repo "$1" || die "no git repo named '$1' found (searched ., the enclosing repo's parent, DISPATCH_REPO_ROOTS, and the registry)"
}

register_repo() {
  mkdir -p "$(dirname "$registry")"
  grep -qxF "$1" "$registry" 2>/dev/null || echo "$1" >> "$registry"
}

# Every repo we can find: the one we're standing in, everything under the roots, the registry.
all_repos() {
  local top r d
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$top" ]]; then
    # inside a dispatch worktree? resolve to the main checkout
    [[ "$top" == */.git/wt/* ]] && top="${top%%/.git/wt/*}"
    echo "$top"
  fi
  local env_roots
  IFS=':' read -r -a env_roots <<< "${DISPATCH_REPO_ROOTS:-$roots_default}"
  for r in "${env_roots[@]}"; do
    [[ -d "$r" ]] || continue
    for d in "$r"/*/; do [[ -d "${d}.git" ]] && echo "${d%/}"; done
  done
  [[ -f "$registry" ]] && cat "$registry"
  return 0
}

uniq_existing() { awk '!seen[$0]++' | while IFS= read -r p; do [[ -n "$p" && -d "$p/.git" ]] && echo "$p"; done; return 0; }

base_branch() {
  local b
  for b in main master; do
    git -C "$1" show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return 0; }
  done
  return 1
}

# ---------------------------------------------------------------- naming
check_issue()  { [[ "$1" =~ ^[0-9]+$ ]] || die "issue must be a number, got: '$1'"; }
check_suffix() { [[ -z "$1" || "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "suffix may only contain letters, digits, '.', '_', '-'; got: '$1'"; }
leaf_name()    { local l="issue-$1"; [[ -n "${2:-}" ]] && l="$l-$2"; echo "$l"; }
wt_path()      { echo "$1/.git/wt/$2"; }

# ---------------------------------------------------------------- worktree + tmux inventory
# "<path>\t<branch>" for every worktree of <repo> under .git/wt/ whose dir still exists.
repo_worktrees() {
  local repo="$1" wt="" br=""
  emit() {
    [[ "$wt" == */.git/wt/* && -d "$wt" ]] && printf '%s\t%s\n' "$wt" "$br"
    wt=""; br=""
  }
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) wt="${line#worktree }" ;;
      branch\ *)   br="${line#branch refs/heads/}" ;;
      detached)    br="(detached)" ;;
      "")          emit ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain 2>/dev/null)
  emit
}

# All live panes: session \t window-index \t window-name \t cwd \t start-command \t current-command
list_panes() {
  tmux ls >/dev/null 2>&1 || return 0
  tmux list-panes -a -F $'#{session_name}\t#{window_index}\t#{window_name}\t#{pane_current_path}\t#{pane_start_command}\t#{pane_current_command}' 2>/dev/null || true
}

# Panes whose cwd is the worktree or inside it.
panes_at() {
  local wt; wt="$(cd "$1" 2>/dev/null && pwd -P || echo "$1")"
  list_panes | awk -F'\t' -v w="$wt" 'index($4, w)==1 && (length($4)==length(w) || substr($4, length(w)+1, 1)=="/")'
}

# Given pane rows, print "live" if any runs claude, "shell" if all are bare shells, else "busy".
panes_state() {
  awk -F'\t' '
    $6 ~ /^(claude(\.exe)?|node)$/ { live=1 }
    $6 !~ /^(claude(\.exe)?|node|zsh|bash|fish|sh|-zsh|-bash)$/ { busy=1 }
    END { if (live) print "live"; else if (busy) print "busy"; else if (NR) print "shell" }'
}

# Latest saved Claude session id for a worktree path (transcripts live under a path-encoded dir).
latest_session_id() {
  local enc latest
  enc="$projects/$(printf '%s' "$1" | sed 's/[/.]/-/g')"
  [[ -d "$enc" ]] || return 1
  latest="$(ls -t "$enc"/*.jsonl 2>/dev/null | head -1)"
  [[ -n "$latest" ]] || return 1
  basename "$latest" .jsonl
}

# Open a window at <wt> in <repo>'s project session running <cmd>; prints "session:index".
open_window() {
  local repo="$1" wt="$2" cmd="$3" name sess
  if command -v sesh >/dev/null 2>&1; then
    sesh window connect "$wt" -t "$repo" -b -c "$cmd" | tail -1
  else
    # sesh naming convention: directory basename, dots -> underscores
    name="$(basename "$repo" | tr . _)"
    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$repo"
    tmux new-window -d -P -F '#{session_name}:#{window_index}' -t "$name" -n "$(basename "$wt")" -c "$wt" "$cmd"
  fi
}

go_to() {   # attach or switch to "session:index"
  local target="$1"
  tmux select-window -t "$target" 2>/dev/null || true
  if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "$target"
  else exec tmux attach -t "${target%%:*}"; fi
}

claude_launch_cmd() {   # <repo-name> <leaf> <skill> <issue> [tier]
  printf 'exec claude --remote-control %q --name %q --model %q --permission-mode bypassPermissions %q' \
    "$1/$2" "$2" "$model" "/$3 #$4${5:+ --$5}"
}
claude_resume_cmd() {   # <repo-name> <leaf> <session-id>
  printf 'exec claude --resume %q --remote-control %q --model %q --permission-mode bypassPermissions' \
    "$3" "$1/$2" "$model"
}

# ================================================================ new
cmd_new() {
  local interactive="" tier="" positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i|--interactive) interactive=1; shift ;;
      --light) tier=light; shift ;;
      --full)  tier=full; shift ;;
      -h|--help) usage 0 ;;
      -*) die "unknown option for new: $1" ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  [[ ${#positional[@]} -ge 2 && ${#positional[@]} -le 3 ]] || { echo "usage: claude-dispatch new <repo> <issue> [suffix] [-i] [--light|--full]" >&2; exit 1; }
  local repo="${positional[0]}" issue="${positional[1]}" suffix="${positional[2]:-}"
  check_issue "$issue"; check_suffix "$suffix"

  local path; path="$(resolve_repo_or_die "$repo")"
  register_repo "$path"
  local name; name="$(basename "$path")"
  local leaf; leaf="$(leaf_name "$issue" "$suffix")"
  local wt; wt="$(wt_path "$path" "$leaf")"
  local skill="dispatch"; [[ -n "$interactive" ]] && skill="dispatch-interactive"

  local title
  title="$(cd "$path" && gh issue view "$issue" --json title -q .title 2>/dev/null)" \
    || die "could not fetch issue #$issue in $name — is gh authed for its remote?"

  # Refuse to double-drive a run that already has a window.
  local rows; rows="$(panes_at "$wt")"
  if [[ -n "$rows" ]]; then
    echo "a window already owns $name/$leaf: $(echo "$rows" | awk -F'\t' '{print $1":"$3}' | sort -u | paste -sd' ' -)" >&2
    echo "attach to it, or start another attempt with a suffix:  claude-dispatch new $repo $issue <suffix>" >&2
    exit 1
  fi

  # Worktree: reuse if present (e.g. after `clean` was skipped), else create on a fresh branch off base.
  if [[ -d "$wt" ]]; then
    echo "• reusing existing worktree $wt ($(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || echo detached))"
  else
    local base; base="$(base_branch "$path")" || die "no main/master branch in $name to branch from"
    mkdir -p "$path/.git/wt"
    if git -C "$path" show-ref --verify --quiet "refs/heads/$leaf"; then
      git -C "$path" worktree add "$wt" "$leaf"
    else
      git -C "$path" worktree add -b "$leaf" "$wt" "$base"
    fi
  fi

  local cmd; cmd="$(claude_launch_cmd "$name" "$leaf" "$skill" "$issue" "$tier")"
  echo "▶ $name #$issue${interactive:+ [interactive]}${tier:+ [$tier]} → window $leaf  (remote control: $name/$leaf): $title"
  echo "  worktree: $wt"
  local target; target="$(open_window "$path" "$wt" "$cmd")"
  [[ -n "$target" ]] || die "could not open a tmux window in $name's session"
  echo "  window:   $target"
  echo "  (first launch in a new worktree shows Claude's workspace-trust prompt — accept it in the window)"
  go_to "$target"
}

# ================================================================ ls
cmd_ls() {
  local repos=()
  if [[ $# -ge 1 && -n "${1:-}" ]]; then
    repos=("$(resolve_repo_or_die "$1")")
  else
    while IFS= read -r p; do repos+=("$p"); done < <(all_repos | uniq_existing)
  fi
  [[ ${#repos[@]} -gt 0 ]] || { echo "no repos to scan (cd into a repo, set DISPATCH_REPO_ROOTS, or run claude-dispatch new once)"; exit 0; }

  local panes; panes="$(list_panes)"
  local rows="" dangling="" repo name base wt br leaf checked
  for repo in "${repos[@]}"; do
    name="$(basename "$repo")"
    base="$(base_branch "$repo" 2>/dev/null || true)"
    # every branch checked out in ANY worktree of this repo (main checkout included)
    checked=" $(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n 's#^branch refs/heads/##p' | paste -sd' ' -) "
    while IFS=$'\t' read -r wt br; do
      [[ -n "$wt" ]] || continue
      leaf="${wt##*/.git/wt/}"
      local prow state window mode dirty ahead
      prow="$(printf '%s\n' "$panes" | awk -F'\t' -v w="$wt" 'index($4, w)==1 && (length($4)==length(w) || substr($4, length(w)+1, 1)=="/")')"
      dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      ahead='?'; [[ -n "$base" ]] && ahead=$(git -C "$wt" rev-list --count "$base..HEAD" 2>/dev/null || echo '?')
      if [[ -n "$prow" ]]; then
        state="$(printf '%s\n' "$prow" | panes_state)"
        window="$(printf '%s\n' "$prow" | awk -F'\t' '{print $1":"$3}' | sort -u | paste -sd, -)"
        mode="$(printf '%s\n' "$prow" | awk -F'\t' '
          $5 ~ /dispatch-interactive/ { m="interactive" } $5 ~ /\/dispatch #/ && m=="" { m="auto" }
          $5 ~ /--resume/ && m=="" { m="resumed" } END { print (m==""?"-":m) }')"
      elif [[ "$dirty" != 0 || ( "$ahead" != 0 && "$ahead" != '?' ) ]]; then
        state="idle*"; window="-"; mode="-"
      else
        state="idle"; window="-"; mode="-"
      fi
      rows+="$state"$'\t'"$window"$'\t'"$mode"$'\t'"$name"$'\t'"$leaf"$'\t'"$br"$'\t'"$ahead"$'\t'"$dirty"$'\n'
    done < <(repo_worktrees "$repo")

    # issue-* branches with no worktree: leftovers from a worktree removed without deleting its branch
    while IFS= read -r b; do
      [[ -n "$b" ]] || continue
      [[ "$checked" == *" $b "* ]] && continue
      local la=0; [[ -n "$base" ]] && la=$(git -C "$repo" rev-list --count "$base..$b" 2>/dev/null || echo '?')
      dangling+="$name"$'\t'"$b"$'\t'"$la"$'\n'
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' 'refs/heads/issue-*' 2>/dev/null)
  done

  if [[ -z "$rows" && -z "$dangling" ]]; then
    echo "No dispatch worktrees or leftover branches in: $(for r in "${repos[@]}"; do basename "$r"; done | paste -sd' ' -)"
    exit 0
  fi
  if [[ -n "$rows" ]]; then
    { printf 'STATE\tWINDOW\tMODE\tREPO\tWORKTREE\tBRANCH\tAHEAD\tDIRTY\n'; printf '%s' "$rows"; } | column -t -s $'\t'
    echo
    echo "  live  = a window is running claude in this worktree"
    echo "  shell = a window is open there but claude is not running — claude-dispatch resume"
    echo "  idle  = no window, clean, 0 ahead — safe: claude-dispatch clean <repo> <issue> [suffix]"
    echo "  idle* = no window but unsaved/un-merged work — inspect before removing"
  fi
  if [[ -n "$dangling" ]]; then
    [[ -n "$rows" ]] && echo
    echo "Leftover issue-* branches (no worktree):"
    { printf 'REPO\tBRANCH\tAHEAD\n'; printf '%s' "$dangling"; } | column -t -s $'\t'
    echo
    echo "  ahead=0 → merged, delete with:  git -C <repo> branch -D <branch>"
    echo "  ahead>0 → un-merged commits; inspect before deleting"
  fi
}

# ================================================================ resume
cmd_resume() {
  local repo_arg="${1:-}" issue="${2:-}" suffix="${3:-}" filter="" matched=0
  # A bare issue number matches issue-N and every issue-N-<suffix>; with a suffix it is exact.
  if [[ -n "$issue" ]]; then check_issue "$issue"; check_suffix "$suffix"; filter="$(leaf_name "$issue" "$suffix")"; fi
  local repos=()
  if [[ -n "$repo_arg" ]]; then
    repos=("$(resolve_repo_or_die "$repo_arg")")
  else
    while IFS= read -r p; do repos+=("$p"); done < <(all_repos | uniq_existing)
  fi
  [[ ${#repos[@]} -gt 0 ]] || { echo "no repos to scan (cd into a repo, set DISPATCH_REPO_ROOTS, or run claude-dispatch new once)"; exit 0; }

  local resumed=0 skipped=0 repo name wt br leaf sid cmd rows state target
  for repo in "${repos[@]}"; do
    name="$(basename "$repo")"
    while IFS=$'\t' read -r wt br; do
      [[ -n "$wt" ]] || continue
      leaf="${wt##*/.git/wt/}"
      if [[ -n "$filter" ]]; then
        if [[ -n "$suffix" ]]; then [[ "$leaf" == "$filter" ]] || continue
        else [[ "$leaf" == "$filter" || "$leaf" == "$filter"-* ]] || continue; fi
      fi
      matched=$((matched+1))
      rows="$(panes_at "$wt")"
      state=""; [[ -n "$rows" ]] && state="$(printf '%s\n' "$rows" | panes_state)"
      case "$state" in
        live) echo "• $name/$leaf — claude already running in $(printf '%s\n' "$rows" | awk -F'\t' '{print $1":"$3}' | head -1), skipping"; skipped=$((skipped+1)); continue ;;
        busy) echo "• $name/$leaf — window $(printf '%s\n' "$rows" | awk -F'\t' '{print $1":"$3}' | head -1) is busy ($(printf '%s\n' "$rows" | awk -F'\t' '{print $6}' | head -1)), skipping"; skipped=$((skipped+1)); continue ;;
      esac
      if ! sid="$(latest_session_id "$wt")"; then
        echo "• $name/$leaf — no saved Claude session, skipping (start fresh: claude-dispatch new $name ${leaf#issue-})"; skipped=$((skipped+1)); continue
      fi
      cmd="$(claude_resume_cmd "$name" "$leaf" "$sid")"
      if [[ "$state" == shell ]]; then
        # a window is already sitting in the worktree (e.g. restored by tmux-resurrect): type into it
        target="$(printf '%s\n' "$rows" | awk -F'\t' '{print $1":"$2}' | head -1)"
        tmux send-keys -t "$target" "$cmd" Enter
      else
        target="$(open_window "$repo" "$wt" "$cmd")"
      fi
      echo "▶ $name/$leaf — resumed ${sid%%-*}… in window $target"
      resumed=$((resumed+1))
    done < <(repo_worktrees "$repo")
  done
  if [[ -n "$filter" && "$matched" -eq 0 ]]; then
    echo "no dispatch worktree matches $filter${suffix:+}${suffix:-[-*]} — see: claude-dispatch ls ${repo_arg:-}" >&2
    exit 1
  fi
  echo
  echo "resumed $resumed, skipped $skipped."
  [[ "$resumed" -gt 0 ]] && echo "Each resumed session reloads its conversation and waits at the prompt — switch to the window and type 'continue'."
  return 0
}

# ================================================================ clean
cmd_clean() {
  local repo="" issue="" suffix="" assume_yes="" force="" a
  for a in "$@"; do
    case "$a" in
      -y|--yes) assume_yes=1 ;;
      --force)  force=1 ;;
      -h|--help) usage 0 ;;
      -*) die "unknown flag for clean: $a" ;;
      *) if [[ -z "$repo" ]]; then repo="$a"; elif [[ -z "$issue" ]]; then issue="$a"; elif [[ -z "$suffix" ]]; then suffix="$a"; else die "too many arguments: $a"; fi ;;
    esac
  done
  [[ -n "$repo" && -n "$issue" ]] || { echo "usage: claude-dispatch clean <repo> <issue> [suffix] [-y] [--force]" >&2; exit 1; }
  check_issue "$issue"; check_suffix "$suffix"

  local path; path="$(resolve_repo_or_die "$repo")"
  local name; name="$(basename "$path")"
  local leaf; leaf="$(leaf_name "$issue" "$suffix")"
  local wt; wt="$(wt_path "$path" "$leaf")"

  local have_wt=""; [[ -d "$wt" ]] && have_wt=1
  local branch=""
  [[ -n "$have_wt" ]] && branch="$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || true)"
  [[ -n "$branch" ]] || branch="$leaf"
  local have_branch=""; git -C "$path" show-ref --verify --quiet "refs/heads/$branch" && have_branch=1
  [[ -n "$have_wt" || -n "$have_branch" ]] || die "nothing to clean: no worktree at $wt and no branch $branch (try: claude-dispatch ls $name)"

  local base; base="$(base_branch "$path" 2>/dev/null || true)"
  local rows="" windows="" dirty=0 ahead=0
  if [[ -n "$have_wt" ]]; then
    rows="$(panes_at "$wt")"
    [[ -n "$rows" ]] && windows="$(printf '%s\n' "$rows" | awk -F'\t' '{print $1":"$2}' | sort -u | paste -sd' ' -)"
    dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    [[ -n "$base" ]] && ahead=$(git -C "$wt" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
  elif [[ -n "$have_branch" && -n "$base" ]]; then
    ahead=$(git -C "$path" rev-list --count "$base..$branch" 2>/dev/null || echo 0)
  fi

  echo "About to tear down:"
  echo "  repo      $name"
  if [[ -n "$have_wt" ]]; then echo "  worktree  $wt"; else echo "  worktree  (already gone) — branch-only cleanup"; fi
  if [[ -n "$have_branch" ]]; then echo "  branch    $branch"; else echo "  branch    $branch (already gone)"; fi
  echo "  window    ${windows:-(none)}"
  echo "  state     dirty=$dirty  ahead-of-${base:-?}=$ahead"

  if [[ ( "$dirty" != 0 || "$ahead" != 0 ) && -z "$force" ]]; then
    echo; echo "Refusing: this has unsaved or un-merged work. Inspect it first:" >&2
    if [[ -n "$have_wt" ]]; then echo "  git -C $wt status; git -C $wt diff" >&2
    else echo "  git -C $path log --oneline ${base:-main}..$branch" >&2; fi
    echo "Then re-run with --force to discard it." >&2
    exit 2
  fi
  if [[ -z "$assume_yes" ]]; then
    printf 'Proceed? [y/N] '
    local reply=""
    if [[ -r /dev/tty ]]; then read -r reply </dev/tty || true; else read -r reply || true; fi
    case "$reply" in y|Y|yes|YES) ;; *) echo "aborted."; exit 0 ;; esac
  fi

  local w
  for w in $windows; do echo "  killing window $w"; tmux kill-window -t "$w" 2>/dev/null || true; done
  if [[ -n "$have_wt" ]]; then
    echo "  removing worktree"
    git -C "$path" worktree remove ${force:+--force} "$wt"
  fi
  if git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "  deleting branch $branch"; git -C "$path" branch -D "$branch" >/dev/null
  fi
  git -C "$path" worktree prune
  echo "done."
}

# ================================================================ dispatch on subcommand
[[ $# -gt 0 ]] || usage 1
case "$1" in
  new)      shift; cmd_new "$@" ;;
  ls|list)  shift; cmd_ls "$@" ;;
  resume)   shift; cmd_resume "$@" ;;
  clean|rm) shift; cmd_clean "$@" ;;
  -h|--help|help) usage 0 ;;
  -*)       usage 1 ;;
  *)        cmd_new "$@" ;;   # shorthand: claude-dispatch <repo> <issue> [suffix] [-i]
esac
